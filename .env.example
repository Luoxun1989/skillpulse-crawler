# SkillPulse Crawler 环境变量模板
# 复制本文件为 .env 后填入真实凭证（**不要 commit .env**）

# 后端 API 基址（与后端 jar 同机）
SKILLPULSE_API_BASE=http://127.0.0.1:8081

# ====== 认证（二选一）======

# 选项 A：自动获取 JWT（推荐，部署时用）
ADMIN_USER=luoshishun
ADMIN_PASS=Gumi_sm99

# 选项 B：手动预取 JWT（调试时用，跳过自动登录）
# SKILLPULSE_ADMIN_JWT=

# 历史去重 SQLite 路径（默认 ./data/runs.sqlite）
SKILLPULSE_CRAWLER_DB=./data/runs.sqlite
